<template>
  <div class="root">
    <swiper class="swiper" index="{{ col }}" loop="false" indicator="true" @change="onChange">
      <!-- 屏0: 品牌亮相 -->
      <div class="screen">
        <image class="bg" src="/common/maixiang/list1.png"></image>
        <image class="logo" src="/common/maixiang/icon.png"></image>
        <text class="brand">脉象</text>
        <div class="brand-line"></div>
        <text class="slogan">每日一刻 · 聆听身体的声音</text>
      </div>

      <!-- 屏1: 脉象观察 -->
      <div class="screen">
        <image class="bg" src="/common/maixiang/list1.png"></image>
        <text class="eyebrow">脉象观察</text>
        <text class="title">三分钟 静心一测</text>
        <div class="title-line"></div>
        <div class="card">
          <div class="feat-row" for="{{ (i, line) in featLines }}" tid="i">
            <div class="dot"></div>
            <text class="feat-text">{{ line }}</text>
          </div>
        </div>
      </div>

      <!-- 屏2: 五脏平衡 -->
      <div class="screen">
        <image class="bg" src="/common/maixiang/list1.png"></image>
        <text class="eyebrow">五脏平衡</text>
        <text class="title">观察平衡趋势</text>
        <div class="title-line"></div>
        <div class="card">
          <div class="organ-row" for="{{ (i, o) in organs }}" tid="i">
            <text class="organ-n">{{ o.n }}</text>
            <text class="organ-d">{{ o.d }}</text>
          </div>
        </div>
      </div>

      <!-- 屏3: 开启入口 -->
      <div class="screen">
        <image class="bg" src="/common/maixiang/list1.png"></image>
        <text class="eyebrow">准备就绪</text>
        <text class="title">开启脉象之旅</text>
        <div class="title-line"></div>
        <input type="button" class="btn-gold" value="开始使用" onclick="startApp" />
        <text class="sub-tip">静心片刻，即刻感受脉息</text>
      </div>
    </swiper>

    <!-- 下一步按钮（末屏隐藏，固定在底部） -->
    <input type="button" class="btn-next" value="下一步" if="{{ col < 3 }}" onclick="next" />
    <!-- 顶部时间（浮层） -->
    <text class="clock">{{ clockText }}</text>
  </div>
</template>

<script>
import router from '@system.router'
import { Storage } from '../../utils/storage'

export default {
  private: {
    col: 0,
    clockText: '--:--',
    featLines: [
      '静坐片刻，记录心率变化',
      '十四种脉象，规则化解读',
      '六维指标，观察变化趋势',
      '融汇脉学，生成科普参考',
    ],
    organs: [
      { n: '心', d: '主血脉，藏神明' },
      { n: '肝', d: '主疏泄，藏血' },
      { n: '脾', d: '主运化，统血' },
      { n: '肺', d: '主气司呼吸' },
      { n: '肾', d: '主藏精，主水' },
    ]
  },

  onChange(e) {
    this.col = e.index;
  },

  onShow() {
    const tick = () => {
      const n = new Date();
      this.clockText = ('0' + n.getHours()).slice(-2) + ':' + ('0' + n.getMinutes()).slice(-2);
    };
    tick();
    if (!this._clockTimer) this._clockTimer = setInterval(tick, 60000);
  },

  onHide() {
    if (this._clockTimer) { clearInterval(this._clockTimer); this._clockTimer = null; }
  },

  onDestroy() {
    if (this._clockTimer) { clearInterval(this._clockTimer); this._clockTimer = null; }
  },

  next() {
    if (this.col < 3) this.col = this.col + 1;
  },

  startApp() {
    // OOBE 标记与业务记录统一使用 @system.file，避开 Vela 4.0
    // 上 @system.storage 的持久化不稳定问题。
    Storage.patch('system.json', {
      oobe_done: '1'
    }, (error) => {
      if (error) {
        console.log('[OOBE-FILE] write failed: ' + JSON.stringify(error));
        return;
      }

      console.log('[OOBE-FILE] write success');
      router.replace({ uri: 'pages/home' });
    });
  }
}
</script>

<style>
.root {
  width: 100%;
  height: 100%;
}

.swiper {
  width: 100%;
  height: 100%;
  indicator-selected-color: #C0A050;
  indicator-color: #C6B896;
  indicator-size: 9px;
}

.screen {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #E8DCBE;
  padding-top: 46px;
}

.clock {
  position: absolute;
  top: 10px;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 26px;
  color: #C09040;
  background-color: transparent;
}

.bg {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 480px;
  height: 480px;
}

/* 屏0 品牌 */
.logo { width: 120px; height: 120px; margin-top: 50px; border-radius: 28px; }
.brand { font-size: 48px; color: #B8860B; margin-top: 24px; }
.brand-line { width: 56px; height: 3px; border-radius: 2px; background-color: #C0A050; margin-top: 14px; }
.slogan { font-size: 23px; color: #5A4632; margin-top: 16px; }

/* 编辑式标题 */
.eyebrow { font-size: 20px; color: #9C8560; }
.title { font-size: 38px; color: #8A5A20; margin-top: 6px; }
.title-line { width: 46px; height: 3px; border-radius: 2px; background-color: #C0A050; margin-top: 12px; margin-bottom: 20px; }

.card {
  width: 374px;
  background-color: #D8CCB2;
  border-radius: 22px;
  flex-direction: column;
  padding: 20px 22px;
}

/* 屏1 特性行 */
.feat-row { align-items: center; height: 42px; }
.dot { width: 8px; height: 8px; border-radius: 4px; background-color: #C0A050; margin-right: 14px; }
.feat-text { font-size: 23px; color: #5A4632; }

/* 屏2 五脏行 */
.organ-row { align-items: center; height: 40px; }
.organ-n { width: 52px; font-size: 30px; color: #8A5A20; }
.organ-d { font-size: 22px; color: #5A4632; }

.sub-tip { font-size: 19px; color: #9C8560; margin-top: 16px; }

/* 屏4 CTA */
.btn-gold {
  width: 288px;
  height: 82px;
  border-radius: 41px;
  background-color: #C0A050;
  color: #1A1206;
  font-size: 28px;
  margin-top: 20px;
}

/* 固定"下一步" */
.btn-next {
  position: absolute;
  left: 155px;
  bottom: 30px;
  width: 170px;
  height: 66px;
  border-radius: 33px;
  background-color: #2A2018;
  color: #C0A050;
  font-size: 26px;
}
</style>
