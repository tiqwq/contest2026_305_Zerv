  width: 100%;
  height: 100%;
}

.bgfix {
  width: 480px;
  height: 480px;
}

.swiper {
  width: 100%;
  height: 100%;
  indicator-selected-color: #C0A050;
  indicator-color: #9E9276;
  indicator-size: 12px;
}

.screen {
  width: 100%;
  height: 100%;
  flex-direction: column;
}

.col {
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 60px 38px 20px 38px;
}

.card {
  width: 404px;
  background-color: #D8CCB2;
  border-radius: 22px;
  padding: 18px 20px;
  margin-bottom: 14px;
}

.pad-bottom { height: 60px; }

/* 标题层级配色（古风：深金 h1 / 青黛 h2 / 中金 h3） */
.h1 { font-size: 32px; color: #8A5A20; margin-bottom: 8px; }
.h2 { font-size: 28px; color: #4E7A88; margin-bottom: 8px; }
.h3 { font-size: 25px; color: #B8860B; margin-top: 12px; margin-bottom: 6px; }
.bold { font-size: 22px; color: #5A4632; font-weight: bold; }
.italic { font-size: 22px; color: #8A6E4E; }
.body-text { font-size: 22px; color: #5A4632; margin-bottom: 8px; }
.li { font-size: 22px; color: #5A4632; margin-top: 4px; }
.quote { font-size: 22px; color: #8A6E4E; font-weight: bold; margin-top: 6px; }
.quote-author { font-size: 20px; color: #8A6E4E; margin-top: 4px; }
.trans { font-size: 22px; color: #5A4632; margin-top: 6px; }
.verse {
  font-size: 22px;
  color: #5A4632;
  background-color: #CBBD9C;
  border-radius: 10px;
  padding: 12px;
  margin-top: 12px;
}
.hr { width: 100%; height: 2px; background-color: #C4B594; margin-top: 12px; margin-bottom: 10px; }

/* 免责声明卡 */
.warn-card { background-color: #CBB489; }
.warn-bar { width: 6px; border-radius: 3px; background-color: #9A3B2E; margin-right: 16px; }
.card-body { flex-direction: column; flex: 1; }
.warn-title { font-size: 26px; color: #9A3B2E; margin-bottom: 8px; }
.warn-text { font-size: 22px; color: #4A3628; }

/* 屏2: 脉象卡 */
.pulse-card { flex-direction: column; }
.pulse-head { width: 100%; justify-content: space-between; align-items: center; }
.pulse-name { font-size: 36px; color: #8A5A20; }
.pulse-nature { font-size: 20px; color: #8A6E4E; }
.gold-sep { width: 100%; height: 2px; background-color: #C0A050; margin-top: 10px; margin-bottom: 12px; }
.pulse-desc { font-size: 23px; color: #5A4632; }
</style>
