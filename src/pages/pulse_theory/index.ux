<template>
  <!-- 固定宣纸底（不随 Swiper 翻页移动，对齐原版视觉） -->
  <stack class="root">
    <image class="bgfix" src="/common/maixiang/list1.png"></image>
    <swiper class="swiper" loop="false" indicator="true">
    <!-- 屏1: 脉诊源流 -->
    <scroll class="screen" scroll-y="true">
      <div class="col">
        <!-- 免责声明（独立醒目卡：暖色底 + 红褐警示标题 + 左饰条） -->
        <div class="card warn-card">
          <div class="warn-bar"></div>
          <div class="card-body">
            <text class="warn-title">免责声明</text>
            <text class="warn-text">{{ t.disclaimer }}</text>
          </div>
        </div>

        <div class="card col">
          <text class="h1">{{ t.title }}</text>
          <text class="italic">{{ t.subtitle }}</text>
        </div>

        <div class="card col">
          <text class="quote">{{ t.quote }}</text>
          <text class="quote-author">{{ t.quoteAuthor }}</text>
          <div class="hr"></div>
          <text class="trans">{{ t.quoteTrans }}</text>
        </div>

        <div class="card col">
          <text class="h2">{{ t.originTitle }}</text>
          <text class="bold">{{ t.originBody }}</text>
          <text class="h3">{{ t.booksTitle }}</text>
          <text class="li" for="{{ (i, b) in t.books }}" tid="i">· {{ b }}</text>
          <text class="verse">{{ t.verse }}</text>
        </div>

        <div class="card col">
          <text class="h2">{{ t.cunkouTitle }}</text>
          <text class="quote">{{ t.cunkouBody }}</text>
          <div class="hr"></div>
          <text class="trans">{{ t.cunkouTrans }}</text>
          <text class="italic">—— 脉理精微，存乎一心</text>
        </div>
        <div class="pad-bottom"></div>
      </div>
    </scroll>

    <!-- 屏2: 二十八脉述要（14 脉一脉一卡） -->
    <scroll class="screen" scroll-y="true">
      <div class="col">
        <div class="card pulse-card" for="{{ (i, p) in pulses }}" tid="i">
          <div class="pulse-head">
            <text class="pulse-name">{{ p.name }}</text>
            <text class="pulse-nature">{{ p.nature }}</text>
          </div>
          <div class="gold-sep"></div>
          <text class="pulse-desc">{{ p.desc }}</text>
        </div>
        <div class="pad-bottom"></div>
      </div>
    </scroll>

    <!-- 屏3: 脉象与健康指南 -->
    <scroll class="screen" scroll-y="true">
      <div class="col">
        <div class="card col">
          <text class="h1">{{ t.guideTitle }}</text>
          <text class="body-text">{{ t.normalPulse }}</text>
          <text class="quote">{{ t.santi }}</text>
          <text class="quote-author">{{ t.santiSource }}</text>
          <div class="hr"></div>
          <text class="trans">{{ t.normalTrans }}</text>
        </div>

        <div class="card col">
          <text class="h2">{{ t.factorsTitle }}</text>
          <text class="li" for="{{ (i, f) in t.factors }}" tid="i">· {{ f }}</text>
          <div class="hr"></div>
          <text class="h3">{{ t.tipTitle }}</text>
          <text class="trans">{{ t.tip }}</text>
        </div>
        <div class="pad-bottom"></div>
      </div>
    </scroll>
    </swiper>
  </stack>
</template>

<script>
import { getText } from '../../utils/strings'

const PULSE_KEYS = ['fu', 'chen', 'chi', 'shuo', 'hua', 'se', 'xu', 'shi', 'xian', 'xi', 'hong', 'huan', 'jie', 'dai'];
const PULSE_NATURE = {
  fu: '阳', chen: '阴', chi: '阴', shuo: '阳', hua: '阳', se: '阴',
  xu: '阴', shi: '阳', xian: '阳', xi: '阴', hong: '阳',
  huan: '平', jie: '阴', dai: '阴'
};

export default {
  private: {
    t: {},
    pulses: []
  },

  onInit() {
    this.t = {
      disclaimer: getText('pulse_theory_disclaimer'),
      title: getText('pulse_theory'),
      subtitle: getText('pulse_theory_subtitle'),
      quote: getText('pulse_theory_quote'),
      quoteAuthor: getText('pulse_theory_quote_author'),
      quoteTrans: getText('pulse_theory_quote_trans'),
      originTitle: getText('pulse_theory_origin_title'),
      originBody: getText('pulse_theory_origin_body'),
      booksTitle: getText('pulse_theory_books_title'),
      books: [
        getText('pulse_theory_book_neijing'),
        getText('pulse_theory_book_nanjing'),
        getText('pulse_theory_book_maijing'),
        getText('pulse_theory_book_binhu'),
      ],
      cunkouTitle: getText('pulse_theory_cunkou_title'),
      verse: '浮脉惟从肉上行，\n沉脉轻取不得寻。\n数脉一息六七至，\n迟脉一息不足三。',
      cunkouBody: getText('pulse_theory_cunkou_body'),
      cunkouTrans: getText('pulse_theory_cunkou_trans'),
      guideTitle: getText('pulse_theory_guide_title'),
      normalPulse: getText('pulse_theory_normal_pulse'),
      normalTrans: getText('pulse_theory_normal_trans'),
      santi: getText('pulse_theory_santi'),
      santiSource: getText('pulse_theory_santi_source'),
      factorsTitle: getText('pulse_theory_factors_title'),
      factors: [
        getText('pulse_theory_factor_emotion'),
        getText('pulse_theory_factor_exercise'),
        getText('pulse_theory_factor_diet'),
        getText('pulse_theory_factor_sleep'),
      ],
      tipTitle: getText('pulse_theory_reading_tip_title'),
      tip: getText('pulse_theory_reading_tip'),
    };

    this.pulses = PULSE_KEYS.map((key) => ({
      name: getText('pulse_name_' + key),
      desc: getText('pulse_desc_' + key),
      nature: (PULSE_NATURE[key] || '') + '脉'
    }));
  }
}
</script>

