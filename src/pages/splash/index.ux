<template>
  <!--
    大赛开源版开屏页：
    首屏图展示后，首次打开进入 OOBE，其他情况直接进入主页。
  -->
  <stack class="root">
    <image class="bg" src="/common/maixiang/first.png"></image>
  </stack>
</template>

<script>
import router from '@system.router'
import { Storage } from '../../utils/storage'

const SPLASH_MS = 900; // 首屏图停留时长
const SYSTEM_FILE = 'system.json'

export default {
  onInit() {
    // 停留展示首屏图后再分流
    setTimeout(() => this._route(), SPLASH_MS);
  },

  _route() {
    Storage.get(SYSTEM_FILE, (error, systemData) => {
      // 文件不存在或读取失败都按首次启动处理，避免进入半初始化状态。
      if (error || !systemData || systemData.oobe_done !== '1') {
        router.replace({ uri: 'pages/oobe' });
        return;
      }

      router.replace({ uri: 'pages/home' });
    });
  }
}
</script>

<style>
.root {
  width: 100%;
  height: 100%;
  background-color: #E8DCBE;
}

.bg {
  width: 480px;
  height: 480px;
}
</style>
